return `<div class="hero"><div><span class="pill">Abrimos local</span><h1 style="margin-top:8px">Pizzas, empanadas y pollo. Pedí en 1 minuto.</h1><p>Elegí, armá tu pedido y lo confirmamos por WhatsApp.</p><p style="margin-top:10px;font-weight:800">Lun a vie de 11 a 14 hs y de 19 a 00:30 hs · Sáb y dom de 12:00 a 00:00 hs</p></div><div class="pic" style="background-image:url('img/cheese.jpg')"></div></div>
<div class="chips">${ks.map(c=>`<button class="chip" onclick="document.getElementById('c-${c}').scrollIntoView({behavior:'smooth'})">${lbl(c)}</button>`).join('')}${soonL().length?`<button class="chip" onclick="document.getElementById('c-soon').scrollIntoView({behavior:'smooth'})">⏳ Próximamente</button>`:''}</div>
${ks.map(c=>`<section id="c-${c}"><h2>${lbl(c)}</h2><div class="grid">${PS().filter(p=>p.cat==c).map(p=>`<div class="card">${ph(p,c)}<div class="b"><h3>${esc(p.nombre)}</h3><small>${esc(p.descripcion)}</small>${p.precio_anterior>0?`<s class="old">${fmt(p.precio_anterior)}</s>`:''}<span class="price">${fmt(p.precio)}</span>${p.etiqueta?`<span class="tg">${esc(p.etiqueta)}</span>`:''}${ctl(p)}</div></div>`).join('')}</div></section>`).join('')}${soonSec()}
<p class="info">Calle 1278 Nº 941, Ingeniero Allan · Envíos por WhatsApp</p><div class="bar" id="bar"></div>`}
function barUpd(){const b=$('#bar');if(!b)return;b.style.display=cnt()?'block':'none';b.innerHTML=`<button onclick="cart()"><span>Ver mi pedido (${cnt()})</span><span>${fmt(tot())}</span></button>`}
function add(id,d){const n=Math.max(0,Math.min(50,(C[id]||0)+d));n?C[id]=n:delete C[id];const y=scrollY;render();scrollTo(0,y);if($('#over').dataset.open)cart()}
function cart(){$('#over').dataset.open=1;const its=Object.entries(C);if(!its.length){close_();return}const v=k=>$('#'+k)?.value||'';
const n=v('cn'),d=v('cd'),x=v('cx');
$('#over').innerHTML=`<div class="modal" onclick="if(event.target==this)close_()"><div class="sheet"><h2 style="color:var(--red)">Tu pedido</h2>
${its.map(([i,q])=>`<div class="row"><div><b>${esc(it_(i).nombre)}</b><br><span class="price" style="font-size:15px">${fmt(it_(i).precio*q)}</span></div><div class="qty"><button onclick="add('${i}',-1)">−</button><b>${q}</b><button onclick="add('${i}',1)">+</button></div></div>`).join('')}
<div class="row"><b>Total</b><b class="price" style="font-size:22px">${fmt(tot())}</b></div>
<label>Tu nombre</label><input id="cn" value="${esc(n)}" placeholder="Ej: Lucía">
<label>¿Cómo lo recibís?</label><div class="seg"><button class="${tipo=='Retiro'?'on':''}" onclick="tipo='Retiro';cart()">Retiro en el local</button><button class="${tipo=='Envío'?'on':''}" onclick="tipo='Envío';cart()">Envío</button></div>
${tipo=='Envío'?`<label>Dirección</label><input id="cd" value="${esc(d)}" placeholder="Calle, número, referencias">`:''}
<label>Forma de pago</label><div class="seg"><button class="${pago=='Efectivo'?'on':''}" onclick="pago='Efectivo';cart()">Efectivo</button><button class="${pago=='Transferencia'?'on':''}" onclick="pago='Transferencia';cart()">Transferencia</button></div>
<label>Aclaraciones (opcional)</label><input id="cx" value="${esc(x)}" placeholder="Sin aceitunas, cambio de $20.000…">
<button class="wa" id="sb" onclick="send()">Enviar pedido por WhatsApp</button><button class="ghost" style="width:100%;margin-top:6px" onclick="close_()">Seguir pidiendo</button></div></div>`}
function close_(){delete $('#over').dataset.open;$('#over').innerHTML=''}
async function send(){const n=$('#cn').value.trim(),d=$('#cd')?.value.trim()||'',x=$('#cx').value.trim();
if(!n){toast('Escribí tu nombre');$('#cn').focus();return}if(tipo=='Envío'&&!d){toast('Falta la dirección');$('#cd').focus();return}
$('#sb').disabled=true;$('#sb').textContent='Enviando…';let id;
try{id=await ok(SB.rpc('crear_pedido',{p_cliente:n,p_entrega:tipo,p_direccion:d,p_pago:pago,p_notas:x,p_items:Object.entries(C).map(([id,q])=>({id,q}))}))}catch(e){$('#sb').disabled=false;$('#sb').textContent='Enviar pedido por WhatsApp';return}
const its=Object.entries(C).map(([i,q])=>({n:it_(i).nombre,q,p:it_(i).precio})),t=sum(its,i=>i.p*i.q);
const txt=`Hola La Tríada! Quiero hacer un pedido (Nº ${id}):\n${its.map(i=>`• ${i.q} x ${i.n} – ${fmt(i.p*i.q)}`).join('\n')}\n\nTotal: ${fmt(t)}\nNombre: ${n}\n${tipo}${d?': '+d:''}\nPago: ${pago}${x?'\nNotas: '+x:''}`;
C={};close_();render();toast('Pedido enviado. Confirmalo en WhatsApp');location.href='https://wa.me/'+CF.whatsapp+'?text='+encodeURIComponent(txt)}
/* ---------- PANEL ---------- */
async function enter(){view='admin';A=null;LK='';render();const{data:{session}}=await SB.auth.getSession();if(!session){LK='login';render();return}
try{const s=await SB.from('staff').select('user_id').maybeSingle();if(!s.data){LK='noperm';render();return}await loadA();render();clearInterval(poll);poll=setInterval(async()=>{if(view=='admin'&&A&&!['INPUT','SELECT'].includes(document.activeElement.tagName)&&tab=='caja'){await loadA();render()}},45000)}catch(e){LK='login';render()}}
async function login(){const{error}=await SB.auth.signInWithPassword({email:$('#em').value.trim(),password:$('#pw').value});if(error){toast('Email o contraseña incorrectos');return}enter()}
