.th{width:44px;height:44px;border-radius:8px;background:#f6e3c2 center/cover;display:inline-block;vertical-align:middle}.note{background:var(--bg);border:1.5px dashed var(--line);border-radius:10px;padding:10px;font-size:14px;margin:8px 0}
.ped{border:1.5px solid var(--or);border-radius:12px;padding:10px;margin:8px 0}.ped .btn+.btn{margin-left:8px;background:var(--mut)}td select{width:auto;padding:5px}td input[type=checkbox]{width:auto}
</style></head><body>
<header><img src="data:image/jpeg;base64," alt="La Tríada"><div class="sp"></div><button class="lnk" id="th" onclick="tema()" aria-label="Cambiar color de fondo"></button><button class="lnk" id="mode" onclick="go()"></button></header>
<div class="wrap" id="app"><p class="info">Cargando…</p></div><div id="over"></div>
<script>
const SB=supabase.createClient('https://miykeuznzfxvhpteiica.supabase.co','sb_publishable_Q1BXwmXSlOwoiorATXGVBw_ShdrDg_2');
const $=s=>document.querySelector(s),fmt=n=>'$'+Math.round(n||0).toLocaleString('es-AR'),esc=s=>String(s??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const today=()=>new Date().toLocaleDateString('sv',{timeZone:'America/Argentina/Buenos_Aires'}),sum=(a,f)=>a.reduce((s,x)=>s+f(x),0);
function toast(t){const d=document.createElement('div');d.className='toast';d.textContent=t;document.body.append(d);setTimeout(()=>d.remove(),2800)}
const ok=async p=>{const r=await p;if(r.error){toast(r.error.message);throw r.error}return r.data};
const CATS={promo:'🔥 Promo',pizza:'🍕 Pizzas',especial:'⭐ De la casa',emp:'🥟 Empanadas',pollo:'🍗 Pollo',beb:'🥤 Bebidas'},E={pizza:'🍕',emp:'🥟',pollo:'🍗',beb:'🥤',especial:'🍕',promo:'🔥'},lbl=c=>CATS[c]||c;
