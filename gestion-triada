const iv=id=>A.inv[id]||{costo:0,stock:0};
const TABS={caja:'Caja del día',cat:'Catálogo e inventario',gas:'Gastos y presupuesto',his:'Cierres'};
function admin(){if(LK=='login')return `<div class="lock"><h2>Panel del local</h2><label>Email</label><input id="em" type="email" autocomplete="username"><label>Contraseña</label><input id="pw" type="password" autocomplete="current-password" onkeydown="if(event.key=='Enter')login()"><button class="btn" style="width:100%;margin-top:10px" onclick="login()">Ingresar</button></div>`;
if(LK=='noperm')return `<div class="lock"><h2>Sin permiso</h2><p class="info">Esta cuenta no está autorizada para usar el panel.</p><button class="btn" onclick="salir()">Cerrar sesión</button></div>`;
if(!A)return '<p class="info">Verificando acceso…</p>';
return `<div class="row" style="border:0"><h2 style="margin:6px 0">Panel del local</h2><span><button class="ghost" onclick="loadA().then(render)">Actualizar</button><button class="ghost" onclick="salir()">Salir</button></span></div><div class="tabs">${Object.entries(TABS).map(([k,v])=>`<button class="chip" style="${tab==k?'background:var(--or);color:#fff;border-color:var(--or)':''}" onclick="tab='${k}';render()">${v}${k=='caja'&&A.ped.some(p=>p.estado=='nuevo')?' 🔴':''}</button>`).join('')}</div>${{caja,cat,gas,his}[tab]()}`}
function dayData(d=today()){const o=A.ped.filter(x=>x.dia==d&&x.estado=='confirmado'),g=A.gas.filter(x=>x.dia==d),v=sum(o,x=>+x.total),c=sum(o,x=>+x.costo),ef=sum(o.filter(x=>x.pago=='Efectivo'),x=>+x.total),ga=sum(g,x=>+x.monto);return{o,g,v,c,ef,tr:v-ef,ga,net:v-c-ga}}
const det=o=>o.pedido_items.map(i=>i.cantidad+' '+esc(i.nombre)).join(', ');
function caja(){const D=dayData(),closed=A.cie.some(c=>c.dia==today()),fo=+CF.fondo_inicial,esp=fo+D.ef-D.ga,sold={},nu=A.ped.filter(p=>p.estado=='nuevo');D.o.forEach(o=>o.pedido_items.forEach(i=>sold[i.producto_id]=(sold[i.producto_id]||0)+i.cantidad));
return `<div class="kp"><div class="k"><span>Ventas de hoy</span><b>${fmt(D.v)}</b></div><div class="k"><span>Costo de lo vendido</span><b>${fmt(D.c)}</b></div><div class="k"><span>Gastos del día</span><b>${fmt(D.ga)}</b></div><div class="k"><span>Ganancia neta</span><b class="${D.net>=0?'pos':'neg'}">${fmt(D.net)}</b></div></div>
<div class="panel"><h3>Pedidos nuevos (${nu.length})</h3>${nu.map(o=>`<div class="ped"><b>Nº ${o.id} · ${esc(o.cliente)}</b> · ${fmt(o.total)}<br>${det(o)}<br><small>${o.entrega}${o.direccion?': '+esc(o.direccion):''} · ${o.pago}${o.notas?' · '+esc(o.notas):''}</small><div style="margin-top:8px"><button class="btn" onclick="conf(${o.id})">Confirmar</button><button class="btn" onclick="canc(${o.id})">Cancelar</button></div></div>`).join('')||'<p class="info">No hay pedidos pendientes. Los pedidos de la tienda aparecen acá solos.</p>'}</div>
<div class="panel"><h3>Venta de mostrador</h3><div class="tw"><table>${PS().map(p=>`<tr><td>${esc(p.nombre)}</td><td>${fmt(p.precio)}</td><td><input type="number" min="0" id="q_${p.id}" placeholder="0"></td></tr>`).join('')}</table></div><div class="f2" style="margin-top:10px"><div><label>Cliente</label><input id="rc" placeholder="Mostrador"></div><div><label>Pago</label><select id="rp"><option>Efectivo</option><option>Transferencia</option></select></div><button class="btn" onclick="reg()">Registrar venta</button></div></div>
<div class="panel"><h3>Cierre de caja ${closed?'<span class="pill" style="background:var(--ok)">Día cerrado</span>':''}</h3><div class="f2"><div><label>Efectivo inicial</label><input type="number" value="${fo}" onchange="cfg('fondo_inicial',+this.value)"></div><div><label>Ventas en efectivo</label><b>${fmt(D.ef)}</b></div><div><label>Transferencias</label><b>${fmt(D.tr)}</b></div><div><label>Efectivo esperado</label><b>${fmt(esp)}</b></div><div><label>Efectivo contado</label><input type="number" id="ct" placeholder="${esp}" oninput="dif()"></div><div><label>Diferencia</label><b id="df">—</b></div></div><button class="btn" style="margin-top:12px" onclick="cerrar(${esp})">Cerrar el día</button></div>
<div class="panel"><h3>Inventario del día</h3><div class="tw"><table><tr><th>Producto</th><th>Vendido hoy</th><th>Stock actual</th></tr>${PS().filter(p=>!p.incluye).map(p=>`<tr><td>${esc(p.nombre)}</td><td>${sold[p.id]||0}</td><td class="${iv(p.id).stock<8?'neg':''}">${iv(p.id).stock}</td></tr>`).join('')}</table></div></div>
<div class="panel"><h3>Ventas confirmadas de hoy (${D.o.length})</h3><div class="tw"><table><tr><th>#</th><th>Cliente</th><th>Detalle</th><th>Pago</th><th>Total</th></tr>${D.o.map(o=>`<tr><td>${o.id}</td><td>${esc(o.cliente)}</td><td>${det(o)}</td><td>${o.pago}</td><td>${fmt(o.total)}</td></tr>`).join('')||'<tr><td colspan=5>Todavía no hay ventas.</td></tr>'}</table></div></div>`}
const act=async(f,m)=>{try{await f();await loadA();render();m&&toast(m)}catch(e){}};
const conf=id=>act(()=>ok(SB.rpc('confirmar_pedido',{p_id:id})),'Pedido confirmado'),canc=id=>act(()=>ok(SB.from('pedidos').update({estado:'cancelado'}).eq('id',id)),'Pedido cancelado');
const cfg=(k,v)=>act(()=>ok(SB.from('config').update({[k]:v}).eq('id',1)),'Guardado');
function reg(){const its=PS().map(p=>({id:p.id,q:+($('#q_'+p.id).value||0)})).filter(i=>i.q>0);if(!its.length){toast('Elegí al menos un producto');return}
act(async()=>{const id=await ok(SB.rpc('crear_pedido',{p_cliente:$('#rc').value.trim()||'Mostrador',p_entrega:'Retiro',p_direccion:'',p_pago:$('#rp').value,p_notas:'Mostrador',p_items:its}));await ok(SB.rpc('confirmar_pedido',{p_id:id}))},'Venta registrada')}
function dif(){const v=$('#ct').value;$('#df').textContent=v===''?'—':fmt(v-(+$('#ct').placeholder));$('#df').className=v===''?'':(v-$('#ct').placeholder>=0?'pos':'neg')}
function cerrar(esp){const v=$('#ct').value;if(v===''){toast('Cargá el efectivo contado');$('#ct').focus();return}const D=dayData();
act(async()=>{await ok(SB.from('cierres').upsert({dia:today(),ventas:D.v,efectivo:D.ef,transferencias:D.tr,costo:D.c,gastos:D.ga,ganancia:D.net,esperado:esp,contado:+v,diferencia:v-esp,stock:PS().filter(p=>!p.incluye).map(p=>[p.nombre,iv(p.id).stock])}));await ok(SB.from('config').update({fondo_inicial:+v}).eq('id',1));tab='his'},'Día cerrado')}
/* ----- catálogo ----- */
const COLS=['id','tipo','categoria','nombre','descripcion','precio','precio_anterior','etiqueta','costo','stock','foto','disponible','fecha_lanzamiento','incluye'];
const slug=s=>s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');
const pe=(id,k,v)=>act(()=>ok(SB.from('productos').update({[k]:v}).eq('id',id)));
const ie=(id,k,v)=>act(()=>ok(SB.from('inventario').upsert({producto_id:id,costo:iv(id).costo,stock:iv(id).stock,[k]:Math.max(0,+v)})));
const se=(id,k,v)=>act(()=>ok(SB.from('proximamente').update({[k]:v||null}).eq('id',id)));
async function foto(t,id,f){if(!f)return;try{const n=`${t}-${id}-${Date.now()}.${f.name.split('.').pop()}`;await ok(SB.storage.from('fotos').upload(n,f,{upsert:true}));await act(()=>ok(SB.from(t).update({foto:SB.storage.from('fotos').getPublicUrl(n).data.publicUrl}).eq('id',id)),'Foto actualizada')}catch(e){}}
function newP(){const n=$('#np').value.trim();if(!n)return;act(()=>ok(SB.from('productos').insert({id:slug(n),nombre:n,cat:$('#nc').value.trim()||'pizza',precio:+$('#npr').value||0,orden:P.length+1})),'Producto agregado')}
function newS(){const n=$('#sn').value.trim();if(!n)return;act(()=>ok(SB.from('proximamente').insert({nombre:n,descripcion:$('#sd').value,fecha:$('#sf').value||null})),'Agregado a Próximamente')}
const ft=(t,p,id)=>`<span class="th" style="${p.foto?`background-image:url('${esc(p.foto)}')`:''}"></span> <input type="file" accept="image/*" style="width:120px" onchange="foto('${t}',${typeof id=='number'?id:`'${id}'`},this.files[0])">`;
function cat(){return `<div class="panel"><h3>Productos</h3><p class="info" style="padding-top:0">Cada cambio se guarda al salir de la celda y se ve al instante en la tienda.</p><div class="tw"><table><tr><th>Foto</th><th>Nombre</th><th>Categoría</th><th>Precio</th><th>Precio ant.</th><th>Etiqueta</th><th>Costo</th><th>Stock</th><th>Margen</th><th>Visible</th><th>Disp.</th></tr>${P.map(p=>`<tr><td>${ft('productos',p,p.id)}</td><td><input value="${esc(p.nombre)}" onchange="pe('${p.id}','nombre',this.value)"></td><td><input value="${esc(p.cat)}" style="width:80px" onchange="pe('${p.id}','cat',this.value)"></td><td><input type="number" value="${p.precio}" onchange="pe('${p.id}','precio',+this.value)"></td><td><input type="number" value="${p.precio_anterior}" onchange="pe('${p.id}','precio_anterior',+this.value)"></td><td><input value="${esc(p.etiqueta)}" style="width:90px" onchange="pe('${p.id}','etiqueta',this.value)"></td>${p.incluye?`<td colspan=2>Usa ${p.incluye.join(' + ')}</td>`:`<td><input type="number" value="${iv(p.id).costo}" onchange="ie('${p.id}','costo',this.value)"></td><td><input type="number" value="${iv(p.id).stock}" onchange="ie('${p.id}','stock',this.value)"></td>`}<td class="pos">${p.precio?Math.round((1-(p.incluye?sum(p.incluye,u=>iv(u).costo):iv(p.id).costo)/p.precio)*100):0}%</td><td><input type="checkbox" ${p.activo?'checked':''} onchange="pe('${p.id}','activo',this.checked)"></td><td><input type="checkbox" ${p.disponible?'checked':''} onchange="pe('${p.id}','disponible',this.checked)"></td></tr>`).join('')}</table></div>
<div class="f2" style="margin-top:12px"><div><label>Nuevo producto</label><input id="np" placeholder="Nombre"></div><div><label>Categoría</label><input id="nc" placeholder="pizza, emp, pollo, beb…"></div><div><label>Precio</label><input id="npr" type="number"></div><button class="btn" onclick="newP()">Agregar</button></div></div>
<div class="panel"><h3>Próximamente</h3><div class="tw"><table><tr><th>Foto</th><th>Nombre</th><th>Descripción</th><th>Lanzamiento</th><th></th></tr>${SO.map(s=>`<tr><td>${ft('proximamente',s,s.id)}</td><td><input value="${esc(s.nombre)}" onchange="se(${s.id},'nombre',this.value)"></td><td><input value="${esc(s.descripcion)}" onchange="se(${s.id},'descripcion',this.value)"></td><td><input type="date" style="width:150px" value="${s.fecha||''}" onchange="se(${s.id},'fecha',this.value)"></td><td><button class="ghost" onclick="act(()=>ok(SB.from('proximamente').delete().eq('id',${s.id})))">Quitar</button></td></tr>`).join('')}</table></div>
<div class="f2" style="margin-top:12px"><div><label>Nombre</label><input id="sn"></div><div><label>Descripción</label><input id="sd"></div><div><label>Fecha de lanzamiento</label><input id="sf" type="date"></div><button class="btn" onclick="newS()">Agregar</button></div></div>
<div class="panel"><h3>WhatsApp del local</h3><label>Con código de país, ej: 5491122334455</label><input value="${esc(CF.whatsapp)}" onchange="cfg('whatsapp',this.value.replace(/\\D/g,''))"></div>
<div class="panel"><h3>Planilla (Excel / Google Sheets)</h3><p class="info" style="padding-top:0">Descargá la planilla, editala y volvé a subirla: actualiza precios, promos, productos nuevos, stock, costos y “Próximamente”. Los productos que no estén en la planilla se ocultan. Si dejás costo o stock vacíos, no se tocan.</p><button class="btn" onclick="dl()">Descargar planilla</button> <input type="file" accept=".xlsx,.xls,.csv" style="width:auto;margin-top:8px" onchange="imp(this.files[0])"><div class="note">Columnas: ${COLS.join(', ')}. En tipo: producto o proximamente.</div></div>`}
function dl(){const q=v=>`"${String(v??'').replace(/"/g,'""')}"`,r=[COLS.join(',')];
P.forEach(p=>r.push([p.id,'producto',p.cat,p.nombre,p.descripcion,p.precio,p.precio_anterior||'',p.etiqueta,p.incluye?'':iv(p.id).costo,p.incluye?'':iv(p.id).stock,p.foto,p.disponible&&p.activo?'si':'no','',(p.incluye||[]).join('+')].map(q).join(',')));
SO.forEach(s=>r.push(['','proximamente','',s.nombre,s.descripcion,'','','','','',s.foto,'',s.fecha||'',''].map(q).join(',')));
const a=document.createElement('a');a.href=URL.createObjectURL(new Blob(['\ufeff'+r.join('\n')],{type:'text/csv'}));a.download='planilla-la-triada.csv';a.click()}
const fd=v=>{if(typeof v=='number')return new Date((v-25569)*864e5).toISOString().slice(0,10);v=String(v).trim();const m=v.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);return m?`${m[3]}-${m[2].padStart(2,'0')}-${m[1].padStart(2,'0')}`:v||null};
async function imp(f){if(!f)return;let rows;try{const wb=XLSX.read(await f.arrayBuffer());rows=XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]],{defval:''})}catch(e){toast('No se pudo leer el archivo');return}
const pr=[],iw=[],so=[];rows.forEach(r=>{const g=k=>String(r[k]??'').trim(),n=g('nombre');if(!n)return;
if(g('tipo').toLowerCase().startsWith('prox')){so.push({nombre:n,descripcion:g('descripcion'),fecha:fd(r.fecha_lanzamiento),foto:g('foto')});return}
const id=g('id')||slug(n),old=it_(id),inc=g('incluye');pr.push({id,cat:g('categoria')||'pizza',nombre:n,descripcion:g('descripcion'),precio:+g('precio')||0,precio_anterior:+g('precio_anterior')||0,etiqueta:g('etiqueta'),foto:g('foto')||old?.foto||'',disponible:!/^(no|n|0|false)$/i.test(g('disponible')),activo:true,incluye:inc?inc.split('+').map(s=>s.trim()):null,orden:pr.length+1});
if(!inc)iw.push({producto_id:id,costo:g('costo')===''?iv(id).costo:+g('costo'),stock:g('stock')===''?iv(id).stock:+g('stock')})});
if(!pr.length){toast('La planilla no tiene productos');return}if(!confirm(`Se van a actualizar ${pr.length} productos y ${so.length} en Próximamente. Los que no estén en la planilla se ocultan. ¿Seguir?`))return;
act(async()=>{await ok(SB.from('productos').update({activo:false}).not('id','in',`(${pr.map(p=>p.id).join(',')})`));await ok(SB.from('productos').upsert(pr));if(iw.length)await ok(SB.from('inventario').upsert(iw));await ok(SB.from('proximamente').delete().gte('id',0));if(so.length)await ok(SB.from('proximamente').insert(so))},'Planilla aplicada')}
/* ----- gastos / cierres ----- */
const RUB=()=>A.pres.map(x=>x.rubro);
function gas(){const m=today().slice(0,7),g=A.gas.filter(x=>x.dia.startsWith(m)),ventas=sum(A.ped.filter(o=>o.dia.startsWith(m)&&o.estado=='confirmado'),o=>+o.total),tb=sum(A.pres,x=>+x.monto),tg=sum(g,x=>+x.monto);
return `<div class="kp"><div class="k"><span>Presupuesto del mes</span><b>${fmt(tb)}</b></div><div class="k"><span>Gastado</span><b>${fmt(tg)}</b></div><div class="k"><span>Disponible</span><b class="${tb-tg>=0?'pos':'neg'}">${fmt(tb-tg)}</b></div><div class="k"><span>Ventas del mes</span><b>${fmt(ventas)}</b></div></div>
<div class="panel"><h3>Presupuesto por rubro</h3>${A.pres.map(b=>{const s=sum(g.filter(x=>x.rubro==b.rubro),x=>+x.monto),p=Math.min(100,s/b.monto*100||0);return `<div style="margin:10px 0"><div class="row" style="border:0;padding:0"><b>${esc(b.rubro)}</b><span>${fmt(s)} de <input type="number" style="width:110px" value="${b.monto}" onchange="act(()=>ok(SB.from('presupuesto').update({monto:+this.value}).eq('rubro','${esc(b.rubro)}')))"></span></div><div class="meter"><i style="width:${p}%;${p>=100?'background:var(--red)':''}"></i></div></div>`}).join('')}</div>
<div class="panel"><h3>Cargar un gasto</h3><div class="f2"><div><label>Concepto</label><input id="gt" placeholder="Ej: Muzzarella 10 kg"></div><div><label>Rubro</label><select id="gc">${RUB().map(k=>`<option>${esc(k)}</option>`).join('')}</select></div><div><label>Monto</label><input id="gm" type="number" placeholder="0"></div><button class="btn" onclick="addG()">Guardar gasto</button></div></div>
<div class="panel"><h3>Gastos del mes</h3><div class="tw"><table><tr><th>Fecha</th><th>Rubro</th><th>Concepto</th><th>Monto</th></tr>${g.map(x=>`<tr><td>${x.dia}</td><td>${esc(x.rubro)}</td><td>${esc(x.concepto)}</td><td>${fmt(x.monto)}</td></tr>`).join('')||'<tr><td colspan=4>Sin gastos cargados.</td></tr>'}</table></div></div>`}
function addG(){const t=$('#gt').value.trim(),m=+$('#gm').value;if(!t||!m){toast('Completá concepto y monto');return}act(()=>ok(SB.from('gastos').insert({rubro:$('#gc').value,concepto:t,monto:m})),'Gasto guardado')}
function his(){return `<div class="panel"><h3>Cierres de caja</h3><div class="tw"><table><tr><th>Fecha</th><th>Ventas</th><th>Costo</th><th>Gastos</th><th>Ganancia</th><th>Esperado</th><th>Contado</th><th>Diferencia</th></tr>${A.cie.map(c=>`<tr><td>${c.dia}</td><td>${fmt(c.ventas)}</td><td>${fmt(c.costo)}</td><td>${fmt(c.gastos)}</td><td class="${c.ganancia>=0?'pos':'neg'}">${fmt(c.ganancia)}</td><td>${fmt(c.esperado)}</td><td>${fmt(c.contado)}</td><td class="${c.diferencia>=0?'pos':'neg'}">${fmt(c.diferencia)}</td></tr>`).join('')||'<tr><td colspan=8>Todavía no cerraste ningún día.</td></tr>'}</table></div></div>`}
function tema(){const d=document.documentElement,n=d.dataset.theme=='dark'?'light':'dark';d.dataset.theme=n;try{localStorage.setItem('lt-theme',n)}catch(e){}tl()}
function tl(){$('#th').textContent=document.documentElement.dataset.theme=='dark'?'☀️ Fondo blanco':'🌙 Fondo negro'}
tl();enter();
</script></body></html>
