function go(){location.href="/"}
function render(){$('#mode').textContent=view=='shop'?'Panel del local':'Ver tienda';$('#app').innerHTML=view=='shop'?shop():admin();$('#over').innerHTML='';if(view=='shop')barUpd()}
/* ---------- TIENDA ---------- */
const cnt=()=>Object.values(C).reduce((a,b)=>a+b,0),tot=()=>Object.entries(C).reduce((a,[i,q])=>a+it_(i).precio*q,0);
