async function loadA(){const s=new Date(Date.now()-62*864e5).toLocaleDateString('sv'),T=t=>SB.from(t).select('*'),d=await Promise.all([ok(T('productos').order('orden')),ok(T('inventario')),ok(SB.from('pedidos').select('*,pedido_items(*)').gte('dia',s).order('id',{ascending:false})),ok(T('gastos').gte('dia',s).order('id',{ascending:false})),ok(T('presupuesto')),ok(T('cierres').order('dia',{ascending:false}).limit(60)),ok(T('config').single()),ok(T('proximamente').order('fecha'))]);
